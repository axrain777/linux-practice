#creating shell variable and assign a value
my_var="Hello, Linux"

#view the value of the variable,$ tells the shell to substitute the value of the variable.Otherwise it will display my_var
#refer to screenshot lss1 in README.md for result
echo $my_var

#Modifying the PATH Environment Variable
#create new directory
mkdir ~/my_scripts

#add  new directory to PATH so that this variable can be used for child process
export PATH="$PATH:$HOME/my_scripts"

#Verify that the new directory has been added
#refer to screenshot lss3 in README.md for result
echo $PATH

#create new file into this new directory without nano.
cat << 'EOF' > ~/my_scripts/hello.sh
#!/bin/zsh 
echo "Hello from my custom script!"
EOF

#Make the script executable
chmod +x ~/my_scripts/hello.sh

#excute script
#refer to screenshot lss4 in README.md for result
hello.sh

#running script from different directory to see if we do it correctly for PATH and export
#refer to screenshot lss5 in README.md for result
cd /tmp
hello.sh

#Learning how to Make Environment Variables Permanent because environment variable will be lost when we close the terminal and sometimes we need the variable for next project
#open the shell file in home directory
nano ~/.zshrc

#adding the variable we want to be permanent inside shell file so that it will be executed everytime the terminal starts
export MY_ENV_VAR="This is an environment variable"
export PATH="$PATH:$HOME/my_scripts"

#apply changes without restarting  terminal
source ~/.zshrc

##Understanding Important Environment Variables

#Points to the home directory of the current user.
echo $HOME

#Contains the username of the current user
echo $USER

#Specifies the user's default shell.
echo $SHELL

#contains the path of the current directory.
echo $PWD

#Specifies the type of terminal to emulate when running the shell.
echo $TERM

##Remove Environment Variables, sometimes we need to remove certain environment variable so this is important

#refer to screenshot lss6 in readme.md for result
#view previously created variable
echo $MY_ENV_VAR

#use unset command to remove
unset MY_ENV_VAR

#verify if removal is done, terminal display the text "MY_ENV_VAR instead of the value of the variable so removal is done correctly
echo $MY_ENV_VAR

